{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "node sync-env.js",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/painel", "destination": "/painel.html" },
    { "source": "/manutencao", "destination": "/index.html" }
  ]
}
